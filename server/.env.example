# FeastFlow Server - Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git — it is listed in .gitignore

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
MONGO_URI=your_mongodb_connection_string_here

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here

# ── Client URL (for CORS & reset-password links) ──────────
CLIENT_URL=http://localhost:5173

# ── Stripe Payments ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# ── Google Gemini AI ──────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── SMTP Email (Brevo / Sendinblue) ───────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login@smtp-brevo.com
SMTP_PASS=your_brevo_smtp_password_here
SMTP_FROM_EMAIL=your_sender_email@gmail.com
