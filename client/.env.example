# FeastFlow Client - Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git — it is listed in .gitignore

# ── API Base URL ─────────────────────────────────────────
VITE_API_URL=http://localhost:5000

# ── App Info ─────────────────────────────────────────────
VITE_APP_NAME=FeastFlow
VITE_APP_VERSION=1.0.0

# ── Stripe (Public Key - safe to expose) ─────────────────
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key_here
